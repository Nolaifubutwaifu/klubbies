NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM=Klubbies <no-reply@klubbies.app>
APP_URL=http://localhost:3000
# Used to hash IP addresses in access_events and rate limits.
SIGNED_URL_SECRET=
# Stripe: secret key, the price clubs pay, and the webhook signing secret.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
# Shown on the terms and refunds pages.
SUPPORT_EMAIL=
# Server errors are emailed here (throttled). Leave empty to only log.
ALERT_EMAIL=
# Vercel Cron sends this as a Bearer token to /api/cron/grace.
CRON_SECRET=
